# --- Application ---------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Database (PostgreSQL 16 + pgvector) ---------------------------------
DATABASE_URL=postgresql+asyncpg://andes:andes@localhost:5432/andes
POSTGRES_USER=andes
POSTGRES_PASSWORD=andes
POSTGRES_DB=andes

# --- Local LLM (Ollama) --------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
# Use the scripted fake LLM instead of Ollama (unit tests set this)
LLM_PROVIDER=ollama

# --- Embeddings ----------------------------------------------------------
# "fake" = deterministic offline embedder; "bge-m3" = local sentence-transformers
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DIM=1024

# --- Observability (Langfuse, optional) ----------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Channels: WhatsApp (Meta Cloud API) ---------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=

# --- Channels: Voice (Twilio + faster-whisper + Piper) -------------------
VOICE_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=

# --- Channels: Email/SMS (MailHog / Twilio) ------------------------------
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=assistant@andes.travel

# --- Payments (Wompi sandbox) --------------------------------------------
PAYMENTS_ENABLED=false
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Booking API mock ----------------------------------------------------
BOOKING_API_URL=http://localhost:8080
